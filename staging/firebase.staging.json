{
  "firestore": {
    "database": "fox-staging-db",
    "rules": "../firestore.rules",
    "indexes": "../firestore.indexes.json"
  },
  "functions": [
    {
      "source": "../functions",
      "codebase": "fox-pilot-staging",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test/**"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "singleProjectMode": true
  }
}
